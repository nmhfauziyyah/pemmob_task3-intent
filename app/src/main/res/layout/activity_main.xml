<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_navy_dark"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/title_student_profile"
            android:textColor="@color/text_white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_profile_picker"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:background="@color/bg_navy_medium"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_camera"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle"
                app:strokeColor="@color/card_border"
                app:strokeWidth="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:text="@string/label_pick_photo"
                android:textColor="@color/text_gray_label"
                android:textSize="12sp" />

            <!-- Input Fields -->
            <TextView
                style="@style/LabelStyle"
                android:text="@string/label_nama_lengkap" />
            <EditText
                android:id="@+id/edt_nama"
                style="@style/InputStyle"
                android:hint="Contoh: Budi Santoso"
                android:inputType="textPersonName" />

            <TextView
                style="@style/LabelStyle"
                android:text="@string/label_nrp" />
            <EditText
                android:id="@+id/edt_nrp"
                style="@style/InputStyle"
                android:hint="Masukkan NRP"
                android:inputType="number" />

            <TextView
                style="@style/LabelStyle"
                android:text="@string/label_phone" />
            <EditText
                android:id="@+id/edt_phone"
                style="@style/InputStyle"
                android:hint="0812XXXXXXXX"
                android:inputType="phone" />

            <TextView
                style="@style/LabelStyle"
                android:text="@string/label_jurusan" />
            <Spinner
                android:id="@+id/sp_jurusan"
                style="@style/SpinnerStyle" />

            <TextView
                style="@style/LabelStyle"
                android:text="@string/label_semester" />
            <Spinner
                android:id="@+id/sp_semester"
                style="@style/SpinnerStyle" />

            <TextView
                style="@style/LabelStyle"
                android:text="@string/label_gender" />
            <RadioGroup
                android:id="@+id/rg_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/rb_male"
                    style="@style/RadioButtonStyle"
                    android:text="@string/gender_male" />
                <RadioButton
                    android:id="@+id/rb_female"
                    style="@style/RadioButtonStyle"
                    android:layout_marginStart="24dp"
                    android:text="@string/gender_female" />
            </RadioGroup>

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_lanjut"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_button_gradient"
            android:text="@string/btn_lanjut"
            android:textColor="@color/text_white"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
